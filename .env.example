# Primary production origin used for canonical URLs, Open Graph, sitemap, and JSON-LD.
VITE_SITE_URL=https://www.crsmdinc.com

# Google Search Console HTML tag verification token (the content= value only).
# Leave empty until you have a real token from Search Console.
VITE_GSC_VERIFICATION=

# Google Analytics measurement ID, for example G-XXXXXXXX. Do not invent an ID.
# Analytics scripts load only when BOTH this ID and VITE_ENABLE_ANALYTICS=true are set.
VITE_GA_ID=

# Set to true only after a consent/privacy review for analytics on a medical website.
VITE_ENABLE_ANALYTICS=false

# Server-side only. Reserved for future non-PHI practice/business email.
# Public patient inquiry and appointment forms are disabled and must not use Resend.
# Never prefix these with VITE_ — Vite would expose them in the browser bundle.
# See FORMS_SETUP.md.
RESEND_API_KEY=
CONTACT_EMAIL=info@crsmdinc.com
FROM_EMAIL=Cardiac Rhythm Specialists <website@crsmdinc.com>
